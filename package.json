{
  "name": "salon-pos-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "node server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "db:plan": "node scripts/plan-migrations.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:verify": "node scripts/verify-migrations.mjs",
    "verify:cashier-payroll-denial": "node scripts/verify-cashier-payroll-denial.mjs",
    "verify:permission-policy": "node scripts/verify-permission-policy.mjs"
  },
  "dependencies": {
    "autoprefixer": "^10.4.22",
    "bcryptjs": "^3.0.3",
    "bikram-sambat": "1.8.1",
    "lucide-react": "^0.553.0",
    "next": "^15.5.25",
    "pg": "^8.12.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2"
  }
}
